{
  "name": "vies-checker",
  "version": "4.0.0",
  "description": "Modern European VIES VAT number validator with full TypeScript support",
  "packageManager": "pnpm@8.15.0",
  "scripts": {
    "build": "rm -rf ./dist && pnpm run build:esm && pnpm run build:cjs && sh ./scripts/build-packages.sh",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "prepare": "pnpm run build",
    "test": "jest --config jestconfig.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itaibo/vies-checker.git"
  },
  "author": "Iñigo Taibo <itaibo@hey.com>",
  "keywords": [
    "vies",
    "europe",
    "european-union",
    "tax",
    "vat",
    "validation",
    "validator",
    "typescript",
    "eu"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/itaibo/vies-checker/issues"
  },
  "homepage": "https://github.com/itaibo/vies-checker#readme",
  "files": [
    "dist/**/*"
  ],
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/esm/index.d.ts"
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^18.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  }
}
